DASHSCOPE_API_KEY=your_api_key_here
# Optional: DashScope workspace, sent as a header only if set
DASHSCOPE_WORKSPACE_ID=your_workspace_id_here
# Region selects the endpoint: ap-southeast-1 (international) or cn-beijing
DASHSCOPE_REGION=ap-southeast-1
# Enables vlm_mode=api on the HTTP service; clients send "Authorization: Bearer <token>"
SERVICE_API_TOKEN=change_me_to_a_long_random_string
